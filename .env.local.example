# =============================================================================
# Gestao Logistica — variaveis de ambiente
# -----------------------------------------------------------------------------
# Aponta para o MESMO projeto Supabase que o sistema atual ja usa.
# As chaves sao as mesmas que estao no index.html de hoje.
#
#   Supabase > Project Settings > Data API  ->  Project URL
#   Supabase > Project Settings > API Keys  ->  anon / publishable
# =============================================================================

NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Nunca coloque a chave service_role aqui: tudo que comeca com NEXT_PUBLIC_
# vai para o navegador e fica visivel para quem abrir o site.
